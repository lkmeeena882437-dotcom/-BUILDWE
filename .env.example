# ─── BUILDWE.ONLINE — copy to .env.local and fill real values ───
# NEVER commit real keys. Client may only read NEXT_PUBLIC_* vars.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BUILDWE.ONLINE

# Supabase (optional permanent-DB mirror for multi-instance deploys).
# Run once in Supabase SQL editor:
#   create table if not exists buildwe_kv (k text primary key, v jsonb not null,
#     updated_at timestamptz default now());
#   alter table buildwe_kv enable row level security;
# Leave blank to use the local JSON store (fine for single instance).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI providers (server-only) ───
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
HF_TOKEN=your_huggingface_token
FAL_KEY=your_fal_key
# Optional user-BYOK encryption secret (server)
# User-pasted keys are AES-256-GCM encrypted with this before storage
BYOK_ENCRYPTION_SECRET=change_me_long_random_string

# Default model IDs (override without code changes)
# Full catalog: lib/ai/models-catalog.ts — Free auto-picks; PRO uses higher quality
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_CHAT_MODEL_PRO=claude-sonnet-4
AI_CODE_MODEL=qwen2.5-coder-32b
AI_CODE_MODEL_PRO=claude-sonnet-code
AI_IMAGE_MODEL=fal-ai/flux/schnell
AI_IMAGE_MODEL_PRO=fal-ai/flux/dev
AI_AUDIO_MODEL=openai-tts-1
AI_AUDIO_MODEL_PRO=elevenlabs-multilingual-v2

# Optional extra provider keys for catalog models
# ELEVENLABS_API_KEY=
# CARTESIA_API_KEY=
# DEEPGRAM_API_KEY=
# GOOGLE_AI_API_KEY=

# ─── Limits (server-enforced; free image/audio hidden in UI) ───
FREE_CODE_DAILY_LIMIT=15
FREE_IMAGE_DAILY_LIMIT=5
FREE_AUDIO_DAILY_LIMIT=5
PRO_CODE_MONTHLY_LIMIT=500
PRO_IMAGE_MONTHLY_LIMIT=999999
PRO_AUDIO_MONTHLY_LIMIT=999999

# ─── Razorpay (India) — TEST keys first ───
# https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Amount in paise (50000 = ₹500). UI shows $5; set INR amount for live.
RAZORPAY_PRO_AMOUNT_PAISE=50000
RAZORPAY_PRO_CURRENCY=INR
RAZORPAY_PRO_PLAN_NAME=BUILDWE PRO
# Optional Razorpay subscription plan id
RAZORPAY_PRO_PLAN_ID=

# Feature flags
# true  = safe demo responses everywhere (payments auto-verify, no live calls)
# false = real provider calls when keys are set
NEXT_PUBLIC_DEMO_MODE=true

# Ads — optional ad-network HTML shown to FREE users in ad slots.
# Leave unset to rotate tasteful BUILDWE house ads.
# NEXT_PUBLIC_AD_HTML=<a href="https://partner.example">Sponsored</a>

# Session signing secret (long random string)
SESSION_SECRET=change-me-to-long-random-string

# ─── OAuth sign-in (optional — buttons gracefully explain until set) ───
# Callback URLs to register with providers (replace your domain):
#   Google: https://YOUR_DOMAIN/api/auth/oauth/google/callback
#   GitHub: https://YOUR_DOMAIN/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Dev convenience: return password-reset links in API responses (LOCAL ONLY)
# SHOW_DEV_LINKS=true

