# ─── BUILDWE.ONLINE — copy to .env.local and fill real values ───
# NEVER commit real keys. Client may only read NEXT_PUBLIC_* vars.

NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=BUILDWE.ONLINE

# Supabase (optional permanent-DB mirror for multi-instance deploys).
# Run once in Supabase SQL editor:
#   create table if not exists buildwe_kv (k text primary key, v jsonb not null,
#     updated_at timestamptz default now());
#   alter table buildwe_kv enable row level security;
# Leave blank to use the local JSON store (fine for single instance).
NEXT_PUBLIC_SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ─── AI providers (server-only) ───
GROQ_API_KEY=your_groq_api_key
OPENROUTER_API_KEY=your_openrouter_api_key
OPENAI_API_KEY=your_openai_api_key
ANTHROPIC_API_KEY=your_anthropic_api_key
GOOGLE_API_KEY=your_google_api_key
HF_TOKEN=your_huggingface_token
FAL_KEY=your_fal_key
# Phase 10 — extra top-tier providers (all optional; router only uses a
# provider whose key is present, so one vendor outage can't kill a capability).
MISTRAL_API_KEY=your_mistral_api_key
DEEPSEEK_API_KEY=your_deepseek_api_key
TOGETHER_API_KEY=your_together_api_key
STABILITY_API_KEY=your_stability_api_key
REPLICATE_API_TOKEN=your_replicate_api_token
GOAPI_API_KEY=your_goapi_api_key
PLAYHT_API_KEY=your_playht_api_key
ELEVENLABS_API_KEY=your_elevenlabs_api_key
DEEPGRAM_API_KEY=your_deepgram_api_key
# Optional user-BYOK encryption secret (server)
# User-pasted keys are AES-256-GCM encrypted with this before storage
BYOK_ENCRYPTION_SECRET=change_me_long_random_string

# Default model IDs (override without code changes)
# Full catalog: lib/ai/models-catalog.ts — Free auto-picks; PRO uses higher quality
AI_CHAT_MODEL=llama-3.3-70b-versatile
AI_CHAT_MODEL_PRO=gpt-4o
AI_CODE_MODEL=qwen-2.5-coder-32b
AI_CODE_MODEL_PRO=claude-3-5-sonnet-20241022
AI_IMAGE_MODEL=fal-ai/flux/schnell
AI_IMAGE_MODEL_PRO=fal-ai/flux/dev
AI_AUDIO_MODEL=openai-audio
AI_AUDIO_MODEL_PRO=eleven_multilingual_v2

# Gemini — long context, summarisation. NOTE: the variable is GOOGLE_API_KEY
# (an earlier version of this file said GOOGLE_AI_API_KEY, which nothing reads).
# GOOGLE_API_KEY=

# Audio now has real adapters too: ElevenLabs (eleven_multilingual_v2 /
# eleven_flash_v2_5) and OpenAI TTS (tts-1 / tts-1-hd) are tried first when
# their key is set, and Pollinations TTS (keyless) remains the universal
# fallback so free audio always works with zero configuration.

# ─── Limits (server-enforced; free image/audio hidden in UI) ───
FREE_CODE_DAILY_LIMIT=15
FREE_IMAGE_DAILY_LIMIT=5
FREE_AUDIO_DAILY_LIMIT=5
PRO_CODE_MONTHLY_LIMIT=500
PRO_IMAGE_MONTHLY_LIMIT=999999
PRO_AUDIO_MONTHLY_LIMIT=999999

# ─── Razorpay (India) — TEST keys first ───
# https://dashboard.razorpay.com/app/keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
# Webhook (audit V6) — REQUIRED for reliable PRO activation.
# Razorpay Dashboard → Settings → Webhooks
#   URL:    https://YOUR_DOMAIN/api/checkout/webhook
#   Events: payment.captured, payment.failed, subscription.charged, subscription.cancelled
# Without this, a customer who pays and closes the tab stays on Free.
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret
# Amount in paise (50000 = ₹500). UI shows $5; set INR amount for live.
RAZORPAY_PRO_AMOUNT_PAISE=50000
RAZORPAY_PRO_CURRENCY=INR
RAZORPAY_PRO_PLAN_NAME=BUILDWE PRO
# Optional Razorpay subscription plan id
RAZORPAY_PRO_PLAN_ID=

# Feature flags
# true  = safe demo responses everywhere (payments auto-verify, no live calls)
# false = real provider calls when keys are set
NEXT_PUBLIC_DEMO_MODE=true

# Ads — optional ad-network HTML shown to FREE users in ad slots.
# Leave unset to rotate tasteful BUILDWE house ads.
# NEXT_PUBLIC_AD_HTML=<a href="https://partner.example">Sponsored</a>

# Session signing secret (long random string)
SESSION_SECRET=change-me-to-long-random-string

# ─── OAuth sign-in (optional — buttons gracefully explain until set) ───
# Callback URLs to register with providers (replace your domain):
#   Google: https://YOUR_DOMAIN/api/auth/oauth/google/callback
#   GitHub: https://YOUR_DOMAIN/api/auth/oauth/github/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=

# Guest identities are HMAC-signed with SESSION_SECRET (audit V1). Old
# unsigned cookies are rejected by default; visitors just get a fresh guest id.
# Set true ONLY for a temporary migration window — it re-opens forgery.
# BUILDWE_ALLOW_LEGACY_GUEST=false

# Dev convenience: return password-reset links in API responses (LOCAL ONLY)
# SHOW_DEV_LINKS=true



# ─────────────────────────────────────────────────────────────
# Multi-provider routing (v1.10.0)
# ─────────────────────────────────────────────────────────────
# BUILDWE routes every request across a catalog of top-tier models spanning
# several vendors (Chat / Code / Image / Audio / STT / Vision). You do NOT need
# all of them — the router only considers providers whose key is present, and
# image/voice work with no key at all.
#
# Recommended minimum for a real deployment:
#   GROQ_API_KEY        free at console.groq.com — unlocks 5 chat + 3 code models
#
# Each extra key widens the fallback chain, so one vendor outage cannot take
# a capability down:
#   OPENROUTER_API_KEY  cross-vendor backup for chat and code
#   ANTHROPIC_API_KEY   Claude — PRO default for long writing and architecture
#   OPENAI_API_KEY      GPT-4o + GPT-4o Vision + OpenAI TTS + DALL·E 3
#   GOOGLE_API_KEY      Gemini — long context and summarisation
#   FAL_KEY             FLUX Dev / Pro image models
#   MISTRAL_API_KEY     Mistral Large 2 (chat backup/fallback)
#   DEEPSEEK_API_KEY    DeepSeek Coder V2 (budget coding)
#   TOGETHER_API_KEY    Qwen 2.5 Coder (edge-case coding)
#   STABILITY_API_KEY   Stable Diffusion 3 (image)
#   GOAPI_API_KEY       Midjourney v6.1 (image, via GoAPI)
#   ELEVENLABS_API_KEY  ElevenLabs TTS (premium voice)
#   PLAYHT_API_KEY      PlayHT TTS (voice cloning)
#   DEEPGRAM_API_KEY    Deepgram Nova-2 (speech-to-text)
#
# Check what's actually reachable at any time:  GET /api/health
#
# Optional per-provider endpoint overrides — point a provider at a proxy or a
# self-hosted compatible gateway. Leave unset for normal deployments.
# AI_BASE_URL_GROQ=https://api.groq.com/openai/v1/chat/completions
# AI_BASE_URL_OPENAI=https://api.openai.com/v1/chat/completions
# AI_BASE_URL_OPENROUTER=https://openrouter.ai/api/v1/chat/completions
# AI_BASE_URL_ANTHROPIC=https://api.anthropic.com/v1/messages


# ─────────────────────────────────────────────────────────────
# Durable infrastructure (v1.11.0) — all free tier
# ─────────────────────────────────────────────────────────────
# Supabase powers THREE things once configured. Run supabase/schema.sql
# once in the SQL Editor, then set these two values:
#
#   1. Durable database  — survives serverless instance recycling
#   2. Durable rate limits — shared counters across all instances
#                            (no Redis / Upstash needed)
#   3. Media storage      — generated audio and images we actually own
#
# NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=<service_role key — server only, never client>
#
# Without these the app still runs: local JSON store, in-memory rate limits,
# audio as data URLs. Nothing breaks, it just isn't durable.
