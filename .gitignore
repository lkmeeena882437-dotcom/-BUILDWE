# dependencies
/node_modules
/.pnp
.pnp.js
.yarn/install-state.gz

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── secrets ────────────────────────────────────────────────────────────────
# Real values live in .env.local (or the host's env). Only .env.example is tracked.
.env
.env.*
!.env.example
*.pem
*.key
*.p12
*.pfx
*.p8
id_rsa
id_ed25519
credentials.json
serviceAccount*.json
.git-askpass.sh
.git-credentials

# typescript
*.tsbuildinfo
next-env.d.ts

# local artifacts
buildwe-main.bundle

# test scratch: os.tmpdir() resolves to ./tmp when TMPDIR is relative,
# and each disposable dev server puts its build cache there
/tmp

# free local db / generated install secrets
/data
*.db

# Vercel CLI pull dumps production env into .env.local — keep the whole dir out
.vercel

# ── internal working notes, kept on disk but never published ────────────────
# This repo is public. Operator runbooks, env cookbooks, and working notes stay
# on disk so a deploy can still follow them; they are not part of the clone.
/docs/internal/
/docs/*.md
